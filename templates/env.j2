PUID={{ radarr_uid }}
PGID={{ radarr_gid }}
TZ={{ radarr_timezone }}

{# Radarr takes its port from the `config.xml` it maintains for itself under
   `radarr_data_path`, which this role does not template. Without this override
   the container would keep listening on Radarr's built-in 7878 no matter what
   `radarr_container_http_port` says, while the port publishing and the Traefik
   labels would point at the configured port and find nothing there. #}
RADARR__SERVER__PORT={{ radarr_container_http_port }}

